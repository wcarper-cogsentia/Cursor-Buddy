{
  "version": 1,
  "hooks": {
    "sessionStart": [{ "command": "BUDDY_FORWARD", "timeout": 2 }],
    "sessionEnd": [{ "command": "BUDDY_FORWARD", "timeout": 2 }],
    "beforeSubmitPrompt": [{ "command": "BUDDY_FORWARD", "timeout": 2 }],
    "preToolUse": [{ "command": "BUDDY_FORWARD", "timeout": 2 }],
    "postToolUseFailure": [{ "command": "BUDDY_FORWARD", "timeout": 2 }],
    "stop": [{ "command": "BUDDY_FORWARD", "timeout": 2 }],
    "afterAgentResponse": [{ "command": "BUDDY_FORWARD", "timeout": 2 }],
    "subagentStart": [{ "command": "BUDDY_FORWARD", "timeout": 2 }],
    "subagentStop": [{ "command": "BUDDY_FORWARD", "timeout": 2 }],
    "beforeMCPExecution": [{ "command": "BUDDY_FORWARD", "timeout": 2 }],
    "beforeShellExecution": [{ "command": "BUDDY_FORWARD", "timeout": 2 }]
  }
}
